{
  "val": [
    {
      "name": "lvis_val",
      "dataset_mode": "patch_episode",
      "source": "lvis",
      "root": "/",
      "anno": "${DATA_ROOT}/LVIS/lvis_v1_val.json",
      "lvis_image_root": "${DATA_ROOT}/LVIS/val2017",
      "box_format": "xyxy",
      "canonical_classes_json": "${DATA_ROOT}/canonical_classes_with_aliases.json",
      "support_patch_tsv": "${DATA_ROOT}/patches_quality_emb/emb_index_from_quality.tsv",
      "support_patch_bucket": "clean",
      "support_patch_use_embedding": false,
      "support_patch_image_root": "${DATA_ROOT}/patches_quality",
      "support_patch_max_per_class": 200,
      "patch_emb_cache_size": 4096,
      "keep_only_patchset_gt": true,
      "neg_episode_prob": 0.0,
      "support_min_count": 2,
      "support_patch_size": 224,
      "support_num_patches_min": 1,
      "support_num_patches_max": 80,
      "patch_text_augment": false,
      "build_text_token_masks": false
    },
    {
      "name": "coco_val",
      "dataset_mode": "patch_episode",
      "source": "coco",
      "root": "/",
      "anno": "${DATA_ROOT}/COCO/coco2017/annotations/instances_val2017.json",
      "coco_image_root": "${DATA_ROOT}/COCO/coco2017/val2017",
      "box_format": "xyxy",
      "canonical_classes_json": "${DATA_ROOT}/canonical_classes_with_aliases.json",
      "support_patch_tsv": "${DATA_ROOT}/patches_quality_emb/emb_index_from_quality.tsv",
      "support_patch_bucket": "clean",
      "support_patch_use_embedding": false,
      "support_patch_image_root": "${DATA_ROOT}/patches_quality",
      "support_patch_max_per_class": 200,
      "patch_emb_cache_size": 4096,
      "keep_only_patchset_gt": true,
      "neg_episode_prob": 0.0,
      "support_min_count": 2,
      "support_patch_size": 224,
      "support_num_patches_min": 1,
      "support_num_patches_max": 80,
      "patch_text_augment": false,
      "build_text_token_masks": false
    }
  ]
}
